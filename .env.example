# Database
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_DB_PASSWORD@db:5432/stock_scanner
DB_PASSWORD=CHANGE_DB_PASSWORD

# App
APP_ENV=production
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Security — openssl rand -hex 32 으로 생성
JWT_SECRET_KEY=CHANGE_THIS_TO_LONG_RANDOM_STRING

# Scheduler
BATCH_CRON_HOUR=17
BATCH_CRON_MINUTE=30
BATCH_TIMEZONE=Asia/Seoul

# Data collection
COLLECT_RETRY_ATTEMPTS=3
COLLECT_RETRY_WAIT_SECONDS=5
PYKRX_REQUEST_DELAY_MS=200

# Scan
DEFAULT_LOOKBACK_DAYS=60
